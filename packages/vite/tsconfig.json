{
  "//": "The base TypeScript configuration of a platform UI build: the platform tsconfig.json extends @tycheg/reasonr-vite/tsconfig.json and includes its own implementations",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "files": ["./app/virtual.d.ts"]
}
