{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@tycheg/reasonr-runtime": ["./packages/runtime/src/index.ts"],
      "@tycheg/reasonr-std-ui": ["./packages/std-ui/src/index.tsx"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "packages/vite/app", "app/src", "app/vite.config.ts", "vitest.config.ts"]
}
